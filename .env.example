# Local evaluation only. Copy to .env.local and run npm run dev:local.
DEV_AUTH=true
PORT=4180
APP_ORIGIN=http://127.0.0.1:4180
# Production requires NODE_ENV=production, DEV_AUTH=false and all settings below.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_AUDIENCE= (API application client ID for v2 tokens)
# ENTRA_SCOPE=api://API_CLIENT_ID/access_as_user
# DATABASE_URL=postgresql://... (server must require TLS)
# AZURE_STORAGE_ACCOUNT_URL=https://ACCOUNT.blob.core.windows.net
# AZURE_STORAGE_CONTAINER=production-private
# APP_ORIGIN=https://production.sdflaw.app
